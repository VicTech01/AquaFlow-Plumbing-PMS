{
  "name": "aquaflow-pms",
  "productName": "AquaFlow PMS",
  "version": "1.3.0",
  "description": "Offline-first plumbing business OS — desktop (Windows) + phone sync over LAN",
  "author": "VicTech Plumbing <victor@victech.co.ke>",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "test": "node smoke.js && node smoke2.js && node smoke3.js && node smoke4.js && node smoke5.js"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ke.victech.aquaflow",
    "productName": "AquaFlow PMS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "css/**",
      "js/**",
      "icons/**",
      "manifest.json",
      "sw.js",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": ["nsis"],
      "icon": "icons/icon-512.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "AquaFlow PMS",
      "runAfterFinish": true
    }
  }
}
